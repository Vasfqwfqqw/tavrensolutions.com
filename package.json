{
  "name": "tavrensolutions",
  "version": "1.0.0",
  "private": true,
  "description": "Tavren Solutions marketing site — static, GitHub Pages.",
  "type": "module",
  "scripts": {
    "build:css": "tailwindcss -i ./src/css/tailwind.css -o ./css/styles.css --minify",
    "build:site": "node ./build/build.mjs",
    "build": "npm run build:css && npm run build:site",
    "watch:css": "tailwindcss -i ./src/css/tailwind.css -o ./css/styles.css --watch",
    "dev": "node ./build/build.mjs && node ./build/serve.mjs",
    "serve": "node ./build/serve.mjs",
    "fonts": "node ./build/fonts.mjs",
    "images": "node ./build/images.mjs"
  },
  "devDependencies": {
    "gray-matter": "^4.0.3",
    "lighthouse": "^13.4.0",
    "marked": "^14.1.3",
    "png-to-ico": "^2.1.8",
    "puppeteer-core": "^25.1.0",
    "sharp": "^0.33.5",
    "tailwindcss": "^3.4.17"
  }
}
